---
import Layout from '../layouts/Layout.astro';

const email = 'wwwlanuscomputacion@gmail.com';
---

<Layout
  title="Contacto — Gas Station"
  description="Contactá a Gas Station: contanos sobre tu estación o tu red y te respondemos a la brevedad. Escribinos a wwwlanuscomputacion@gmail.com."
  current="contacto"
>
  <section class="bg-zinc-950" aria-labelledby="contacto">
    <div class="mx-auto w-full max-w-6xl px-4 py-20 sm:px-6">
      <h1 id="contacto" class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        Contacto
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-zinc-300">
        Contanos sobre tu estación o tu red de estaciones y te respondemos a la
        brevedad.
      </p>
    </div>
  </section>

  <section class="bg-zinc-50" aria-label="Formulario de contacto">
    <div class="mx-auto grid w-full max-w-6xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1fr_320px]">
      <div class="rounded-2xl border border-zinc-200 bg-white p-8 shadow-sm">
        <h2 class="text-2xl font-bold tracking-tight text-zinc-900">
          Escribinos
        </h2>
        <p class="mt-2 text-sm text-zinc-600">
          Completá el formulario y mandanos tu consulta.
        </p>
        <form
          action={`mailto:${email}`}
          method="post"
          enctype="text/plain"
          class="mt-8 grid gap-5"
        >
          <div>
            <label for="nombre" class="mb-1.5 block text-sm font-semibold text-zinc-900">
              Nombre y apellido
            </label>
            <input
              type="text"
              id="nombre"
              name="nombre"
              required
              minlength="2"
              autocomplete="name"
              class="w-full rounded-lg border border-zinc-500 bg-white px-3.5 py-2.5 text-sm text-zinc-900 placeholder-zinc-500 focus:border-zinc-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-900"
              placeholder="Como te llamas"
            />
          </div>
          <div>
            <label for="email" class="mb-1.5 block text-sm font-semibold text-zinc-900">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="w-full rounded-lg border border-zinc-500 bg-white px-3.5 py-2.5 text-sm text-zinc-900 placeholder-zinc-500 focus:border-zinc-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-900"
              placeholder="tu@email.com"
            />
          </div>
          <div>
            <label for="telefono" class="mb-1.5 block text-sm font-semibold text-zinc-900">
              Teléfono
            </label>
            <input
              type="tel"
              id="telefono"
              name="telefono"
              required
              minlength="6"
              pattern="[0-9+() -]{6,20}"
              autocomplete="tel"
              class="w-full rounded-lg border border-zinc-500 bg-white px-3.5 py-2.5 text-sm text-zinc-900 placeholder-zinc-500 focus:border-zinc-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-900"
              placeholder="Con característica, ej. 11 5555-5555"
            />
          </div>
          <div>
            <label for="mensaje" class="mb-1.5 block text-sm font-semibold text-zinc-900">
              Mensaje
            </label>
            <textarea
              id="mensaje"
              name="mensaje"
              required
              minlength="10"
              rows="6"
              class="w-full rounded-lg border border-zinc-500 bg-white px-3.5 py-2.5 text-sm text-zinc-900 placeholder-zinc-500 focus:border-zinc-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-900"
              placeholder="Contanos qué necesitás"></textarea>
          </div>
          <div>
            <button
              type="submit"
              class="rounded-lg bg-zinc-900 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-zinc-700"
            >
              Enviar mensaje
            </button>
          </div>
          <p class="text-xs leading-relaxed text-zinc-600">
            Al enviar se abre tu aplicación de correo con el mensaje listo para
            mandar. Si preferís, escribinos directo a
            <a class="font-semibold text-zinc-900 underline underline-offset-2" href={`mailto:${email}`}>
              {email}
            </a>.
          </p>
        </form>
      </div>

      <aside class="grid content-start gap-6" aria-label="Datos de contacto">
        <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
          <h2 class="text-base font-semibold text-zinc-900">Email</h2>
          <a
            class="mt-2 block break-all text-sm font-medium text-zinc-900 underline underline-offset-2"
            href={`mailto:${email}`}
          >
            {email}
          </a>
        </div>
        <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
          <h2 class="text-base font-semibold text-zinc-900">Tiempo de respuesta</h2>
          <p class="mt-2 text-sm leading-relaxed text-zinc-600">
            Respondemos consultas en 24 a 48 horas hábiles.
          </p>
        </div>
        <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
          <h2 class="text-base font-semibold text-zinc-900">¿Ya tenés cuenta?</h2>
          <p class="mt-2 text-sm leading-relaxed text-zinc-600">
            Si ya usás la plataforma, accedé desde
            <a
              class="font-semibold text-zinc-900 underline underline-offset-2"
              href="https://gas-station.selvaggi-esteban.workers.dev/login"
            >
              tu cuenta
            </a>
            o consultá por
            <a class="font-semibold text-zinc-900 underline underline-offset-2" href="/precios/">
              los planes
            </a>.
          </p>
        </div>
      </aside>
    </div>
  </section>
</Layout>
