---

<article class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm">
  <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-lg bg-zinc-900">
    <svg
      aria-hidden="true"
      class="h-6 w-6 text-white"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.6"
      stroke="currentColor"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d={paths[icon]}></path>
    </svg>
  </div>
  <h3 class="text-base font-semibold text-zinc-900">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-zinc-600">{description}</p>
</article>
