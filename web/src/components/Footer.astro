---
const registroUrl = 'https://gas-station.selvaggi-esteban.workers.dev/registro';
const loginUrl = 'https://gas-station.selvaggi-esteban.workers.dev/login';
---

<footer class="border-t border-zinc-800 bg-zinc-950 text-zinc-300">
  <div class="mx-auto grid w-full max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-2.5">
        <svg viewBox="0 0 32 32" aria-hidden="true" class="h-8 w-8">
          <rect width="32" height="32" rx="7" fill="#fff"></rect>
          <path d="M16 5.5c0 0-7 8.1-7 12.4a7 7 0 0 0 14 0C23 13.6 16 5.5 16 5.5z" fill="#09090b"></path>
          <circle cx="16" cy="18.5" r="2.6" fill="#fff"></circle>
        </svg>
        <span class="text-lg font-bold text-white">Gas Station</span>
      </div>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-zinc-400">
        Sistema de gestión para estaciones de servicio: catálogo propio, marca
        blanca, puntos y competencia.
      </p>
    </div>
    <nav aria-label="Pie de página" class="grid gap-3 text-sm">
      <span class="font-semibold text-white">Sitio</span>
      <a class="w-fit hover:text-white" href="/">Inicio</a>
      <a class="w-fit hover:text-white" href="/precios/">Precios</a>
      <a class="w-fit hover:text-white" href="/contacto/">Contacto</a>
    </nav>
    <div class="grid gap-3 text-sm">
      <span class="font-semibold text-white">Cuenta</span>
      <a class="w-fit hover:text-white" href={loginUrl}>Accedé</a>
      <a class="w-fit hover:text-white" href={registroUrl}>Creá tu cuenta</a>
      <a class="w-fit hover:text-white" href="mailto:wwwlanuscomputacion@gmail.com">
        wwwlanuscomputacion@gmail.com
      </a>
    </div>
  </div>
  <div class="border-t border-zinc-800">
    <p class="mx-auto w-full max-w-6xl px-4 py-5 text-xs text-zinc-400 sm:px-6">
      © 2026 Gas Station. Todos los derechos reservados.
    </p>
  </div>
</footer>
