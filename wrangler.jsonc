{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gas-station",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gas-station-db",
      "database_id": "d550427d-530a-40bb-8996-abc95655c0f2",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "gas-station-assets"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "BRAND_NAME": "LESCO GNC",
    "PBKDF2_ITERATIONS": "30000"
  }
}
