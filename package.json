{
  "name": "gas-station",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Gas Station — plataforma white-label (Cloudflare Workers Free)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply gas-station-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply gas-station-db --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.98.0"
  }
}
