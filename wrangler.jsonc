{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gas-station",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gas-station-db",
      "database_id": "77eb09cf-d0c0-495b-af8a-c7e0107398ea",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "gas-station-assets"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
